<>
  a skos:ConceptScheme ;
  dct:title    "Bestandsschutzmaßnahmen"@de, " „Preservation & digitization actions"@en ;
  dct:creator <http://lobid.org/team/ap> ;
  dct:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
  dct:description "Dies ist eine SKOS-Repräsentation der Terminologieliste für Bestandsschutzmaßnahmen in MARC 583 Unterfeld $a, siehe [https://www.agkva.org/919503035.html](https://www.agkva.org/919503035.html)"@de ;
  vann:preferredNamespacePrefix "preservation" ;
  vann:preferredNamespaceUri "https://w3id.org/lobid/preservation/" ;
  skos:hasTopConcept
    <eb>,
    <a>,
    <b>,
    <c>,
    <d>,
    <f>,
    <g>,
    <h>,
    <i>.


